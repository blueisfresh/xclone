generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  username       String?
  newUser        Boolean?
  hashedPassword String?
  providerId     String?
  provider       String?
  createdAt      DateTime @default(now()) @db.Timestamptz

  profile               Profile?
  sessions              Session[]
  posts                 Post[]
  likes                 Like[]
  reposts               Repost[]
  messages              Message[]
  notificationsSent     Notification[] @relation("NotificationSender")
  notificationsReceived Notification[] @relation("NotificationRecipient")

  following UserFollows[] @relation("UserFollowing")
  followers UserFollows[] @relation("UserFollowers")

  chatsStarted  Chat[] @relation("ChatUser")
  chatsReceived Chat[] @relation("ChatParticipant")
}

model Profile {
  id      Int       @id @default(autoincrement())
  name    String
  bio     String?
  img     String?
  website String?
  dob     DateTime? @db.Timestamptz

  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id])
}

model Session {
  id             Int      @id @default(autoincrement())
  refreshToken   String
  expirationTime DateTime @db.Timestamptz
  createdAt      DateTime @default(now()) @db.Timestamptz

  userId Int?
  user   User? @relation(fields: [userId], references: [id])
}

model Post {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now()) @db.Timestamptz

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  // DB: parentPostId (CamelCase)
  parentPostId Int?
  parent       Post?  @relation("PostReplies", fields: [parentPostId], references: [id])
  replies      Post[] @relation("PostReplies")

  likes   Like[]
  reposts Repost[]
}

model Like {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @db.Timestamptz

  postId Int
  post   Post @relation(fields: [postId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model Repost {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @db.Timestamptz

  postId Int
  post   Post @relation(fields: [postId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model UserFollows {
  userId     Int
  followerId Int

  user     User @relation("UserFollowers", fields: [userId], references: [id])
  follower User @relation("UserFollowing", fields: [followerId], references: [id])

  @@id([userId, followerId])
}

model Chat {
  id Int @id @default(autoincrement())

  userId        Int
  participantId Int

  user        User @relation("ChatUser", fields: [userId], references: [id])
  participant User @relation("ChatParticipant", fields: [participantId], references: [id])

  messages Message[]
}

model Message {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now()) @db.Timestamptz
  read      Boolean?

  userId Int
  user   User @relation(fields: [userId], references: [id])

  chatId Int?
  chat   Chat? @relation(fields: [chatId], references: [id])
}

model Notification {
  id         Int      @id @default(autoincrement())
  type       String
  objectType String
  objectUri  Int
  read       Boolean?
  createdAt  DateTime @default(now()) @db.Timestamptz

  senderId Int
  sender   User @relation("NotificationSender", fields: [senderId], references: [id])

  recipientId Int
  recipient   User @relation("NotificationRecipient", fields: [recipientId], references: [id])
}
